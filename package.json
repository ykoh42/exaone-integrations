{
  "name": "exaone-integrations",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint packages/strands-exaone-typescript --deny-warnings",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:watch": "npm run build",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "openai": "^6.49.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
