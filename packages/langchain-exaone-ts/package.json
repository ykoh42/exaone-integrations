{
  "name": "langchain-exaone",
  "version": "0.1.2",
  "description": "LangChain chat model integration for the EXAONE API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples/README.md",
    "examples/deepagents/README.md",
    "examples/deepagents/agent.ts",
    "examples/deepagents/package.json",
    "examples/deepagents/tsconfig.json",
    "examples/langchain/README.md",
    "examples/langchain/agent.ts",
    "examples/langchain/chat.ts",
    "examples/langchain/package.json",
    "examples/langchain/structured-output.ts",
    "examples/langchain/tsconfig.json",
    "examples/langgraph/README.md",
    "examples/langgraph/agent.ts",
    "examples/langgraph/package.json",
    "examples/langgraph/tsconfig.json",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ykoh42/exaone-integrations/tree/main/packages/langchain-exaone-ts#readme",
  "bugs": {
    "url": "https://github.com/ykoh42/exaone-integrations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/exaone-integrations.git",
    "directory": "packages/langchain-exaone-ts"
  },
  "license": "MIT",
  "keywords": [
    "exaone",
    "langchain",
    "langchain.js",
    "chat model",
    "llm",
    "reasoning",
    "tool calling"
  ],
  "peerDependencies": {
    "@langchain/core": "^1.3.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.7",
    "@types/node": "^26.6.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint src test examples --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  }
}
