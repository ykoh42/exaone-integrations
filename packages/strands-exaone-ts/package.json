{
  "name": "strands-exaone",
  "version": "0.2.2",
  "description": "EXAONE model provider for Strands Agents",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.ts",
    "dist/**/*.mts",
    "dist/**/*.cts",
    "dist/**/*.map",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "!**/.env",
    "!**/.env.*",
    "!**/.envrc",
    "!**/.envrc.*",
    "**/.env.example",
    "**/.envrc.example",
    "!**/.direnv/**",
    "examples/README.md",
    "examples/harness/README.md",
    "examples/harness/agent.ts",
    "examples/harness/package.json",
    "examples/harness/tools.ts",
    "examples/harness/tsconfig.json",
    "examples/sdk/README.md",
    "examples/sdk/agent.ts",
    "examples/sdk/package.json",
    "examples/sdk/streaming.ts",
    "examples/sdk/structured-output.ts",
    "examples/sdk/tsconfig.json",
    "examples/strands-cli/README.md",
    "examples/strands-cli/agent.ts",
    "examples/strands-cli/package.json",
    "examples/strands-cli/tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/exaone-integrations.git",
    "directory": "packages/strands-exaone-ts"
  },
  "homepage": "https://github.com/ykoh42/exaone-integrations/tree/main/packages/strands-exaone-ts#readme",
  "bugs": {
    "url": "https://github.com/ykoh42/exaone-integrations/issues"
  },
  "keywords": [
    "exaone",
    "strands",
    "strands agents",
    "ai agents",
    "model provider",
    "reasoning",
    "tool calling"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@strands-agents/sdk": ">=1.24.0 <2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@strands-agents/harness": "~0.5.0",
    "@strands-agents/sdk": "1.26.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.6"
  },
  "license": "MIT"
}
