{
  "name": "langchain-exaone",
  "version": "0.1.0",
  "description": "LangChain chat model integration for the EXAONE API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "examples", "LICENSE", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/exaone-integrations.git",
    "directory": "packages/langchain-exaone-typescript"
  },
  "license": "MIT",
  "peerDependencies": {
    "@langchain/core": "^1.3.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.7",
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint src test examples --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  }
}
